datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// ==========================================
// ESTRUTURA E CRIAÇÃO DO SURVEY
// ==========================================

model User {
  id                      String                  @id @default(uuid())
  name                    String
  email                   String                  @unique
  password                String
  role                    UserRole                @default(USER)
  status                  UserStatus              @default(BLOCKED)
  surveys                 Survey[]
  sessions                UserSession[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  portfolioProfile        PortfolioProfile?
  portfolioInterests      PortfolioInterest[]
  portfolioEducations     PortfolioEducation[]
  portfolioEvents         PortfolioEvent[]
  portfolioPages          PortfolioPage[]
  portfolioToolCategories PortfolioToolCategory[]
  portfolioTools          PortfolioTool[]
  surveyCategories        SurveyCategory[]
}

model UserSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime? @default(now())
  lastUsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Survey {
  id           String       @id @default(uuid())
  title        String
  description  String?
  instructions String?
  status       SurveyStatus @default(DRAFT)

  publicSlug       String? @unique
  publicLinkActive Boolean @default(false)
  isHighlighted    Boolean @default(false)

  participantIdentificationType ParticipantIdentificationType @default(ANONYMOUS)
  allowMultipleResponses        Boolean                       @default(true)

  researcherId String
  researcher   User   @relation(fields: [researcherId], references: [id])

  categoryId   String?
  category     SurveyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  blocks    Block[]
  responses SurveyResponse[]
  reports   Report[]
  theme     SurveyTheme?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SurveyCategory {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surveys   Survey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

enum ParticipantIdentificationType {
  ANONYMOUS
  EMAIL
  PHONE
  EMAIL_OR_PHONE
  NAME_AND_EMAIL
}

model Block {
  id          String  @id @default(uuid())
  title       String?
  description String?
  orderIndex  Int

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  questions     Question[]
  rulesTargeted ConditionalRule[] @relation("TargetBlock")
  trackings     BlockTracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        QuestionType
  isRequired  Boolean      @default(true)
  orderIndex  Int

  // Configurações avançadas para Escalas Likert/Sliders
  scaleStart      Int?
  scaleEnd        Int?
  scaleVisualType ScaleVisualType?

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)

  scaleOptions QuestionScaleOption[]

  options QuestionOption[]
  medias  Media[]
  rules   ConditionalRule[]
  answers Answer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  LIKERT
  SLIDER
  MEDIA_ONLY
  PERCEPTION_TEST
  MONITORED_READING
}

enum ScaleVisualType {
  NUMBERS
  EMOJIS
  ICONS
  SLIDER
  TEXT_LABELS
}

model QuestionScaleOption {
  id String @id @default(uuid())

  numericValue Int

  label String?
  emoji String?
  icon  String?

  orderIndex Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([questionId, numericValue])
  @@index([questionId])
}

model QuestionOption {
  id         String @id @default(uuid())
  label      String
  value      Int? // Valor numérico obrigatório para análise de escalas (RN03)
  orderIndex Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers Answer[]
}

model Media {
  id   String    @id @default(uuid())
  type MediaType

  url      String
  fileName String?

  mimeType String?
  fileSize Int?

  storageKey String?

  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  interactions MediaInteraction[]

  createdAt DateTime @default(now())
}

enum MediaType {
  AUDIO
  VIDEO
  IMAGE
}

model ConditionalRule {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  operator   RuleOperator
  matchValue String // O valor esperado (ex: "vermelho" ou ID da opção) para disparar a regra

  targetBlockId String
  targetBlock   Block  @relation("TargetBlock", fields: [targetBlockId], references: [id], onDelete: Cascade)
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  LESS_THAN
}

// ==========================================
// TRACKING, COLETA E RESPOSTAS
// ==========================================

model Participant {
  id    String  @id @default(uuid())
  name  String?
  email String?
  phone String?

  responses SurveyResponse[]

  createdAt DateTime @default(now())
}

model SurveyResponse {
  id          String         @id @default(uuid())
  status      ResponseStatus @default(IN_PROGRESS)
  totalTimeMs Int? // Tempo total do survey

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id])

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  answers           Answer[]
  blockTrackings    BlockTracking[]
  mediaInteractions MediaInteraction[]
}

enum ResponseStatus {
  IN_PROGRESS
  COMPLETED
}

model Answer {
  id           String  @id @default(uuid())
  textValue    String?
  numericValue Int? // Resposta visual convertida em numérico
  timeSpentMs  Int? // Tempo gasto apenas nesta pergunta/tela

  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId   String?
  selectedOption     QuestionOption? @relation(fields: [selectedOptionId], references: [id])
  selectedOptionsIds String[]

  createdAt DateTime @default(now())
}

model BlockTracking {
  id          String    @id @default(uuid())
  enteredAt   DateTime
  leftAt      DateTime?
  timeSpentMs Int?
  orderIndex  Int // Para preservar a exata sequência que o usuário percorreu

  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  blockId String
  block   Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model MediaInteraction {
  id              String               @id @default(uuid())
  interactionType MediaInteractionType
  timestamp       DateTime             @default(now())
  timeOffsetMs    Int? // Em que segundo do vídeo/áudio ocorreu o clique (opcional)

  responseId String
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

enum MediaInteractionType {
  PLAY
  PAUSE
  END
  CLICK
}

// ==========================================
// RELATÓRIOS
// ==========================================

model Report {
  id      String @id @default(uuid())
  name    String
  filters Json

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TEMA / CUSTOMIZAÇÃO
// ==========================================

model SurveyTheme {
  id              String      @id @default(uuid())
  primaryColor    String      @default("#000000")
  backgroundColor String      @default("#ffffff")
  textColor       String      @default("#000000")
  buttonColor     String      @default("#000000")
  fontFamily      String      @default("Inter")
  headerImage     String?
  layout          ThemeLayout @default(CARD)

  surveyId String @unique
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

enum ThemeLayout {
  CARD
  FULL_PAGE
  COMPACT
}

// ==========================================
// PORTFOLIO / INSTITUTIONAL CMS
// ==========================================

model PortfolioProfile {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  title       String?
  institution String?
  avatarUrl   String?
  aboutPt     String? @db.Text
  aboutEn     String? @db.Text
  githubUrl   String?
  showGithub  Boolean @default(true)
  lattesUrl   String?
  showLattes  Boolean @default(true)
  linkedinUrl String?
  showLinkedin Boolean @default(true)
  email       String?
  showEmail   Boolean @default(true)
  address     String? @db.Text
  themeColor  String? @default("#000000")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioInterest {
  id         String @id @default(uuid())
  namePt     String
  nameEn     String
  orderIndex Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioEducation {
  id          String @id @default(uuid())
  degreePt    String
  degreeEn    String
  institution String
  year        Int
  orderIndex  Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioEvent {
  id          String   @id @default(uuid())
  titlePt     String
  titleEn     String
  date        DateTime
  institution String
  slidesUrl   String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioPage {
  id        String  @id @default(uuid())
  slug      String // e.g., 'research', 'teaching', 'group'
  titlePt   String
  titleEn   String
  contentPt String? @db.Text
  contentEn String? @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model PortfolioToolCategory {
  id     String @id @default(uuid())
  namePt String
  nameEn String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tools PortfolioTool[]
}

model PortfolioTool {
  id            String  @id @default(uuid())
  name          String
  descriptionPt String
  descriptionEn String
  url           String?
  icon          String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categories PortfolioToolCategory[]
}
